[Unit]
Description=SIGAB encrypted logical backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sigab-backup
Group=sigab-backup
EnvironmentFile=/etc/sigab/backup.env
ExecStart=/opt/sigab/ops/backup/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/sigab
